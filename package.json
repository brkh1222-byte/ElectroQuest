{
  "name": "zasvar-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-ort.mjs",
    "gen": "node scripts/gen-data-index.mjs",
    "check:classes": "node scripts/check-classes.mjs",
    "check:data": "tsx scripts/validate-data.ts",
    "predev": "npm run gen",
    "dev": "next dev",
    "prebuild": "npm run gen && npm run check:classes && npm run check:data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npm run gen && next typegen && tsc --noEmit",
    "pretest": "npm run gen",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "idb": "^8.0.4",
    "next": "16.4.2",
    "onnxruntime-web": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
