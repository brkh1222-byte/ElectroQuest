{
  "id": "arduino-blink",
  "title": {
    "mn": "Arduino: анивчих LED",
    "en": "Arduino: blink"
  },
  "summary": {
    "mn": "Анхны програм: LED-ийг анивчуулна.",
    "en": "Your first program: blink an LED."
  },
  "difficulty": 1,
  "time_minutes": 15,
  "what_you_learn": {
    "mn": "Програм бичиж, Arduino-д ачаалах.",
    "en": "Writing a program and uploading it to an Arduino."
  },
  "supply_v": 5,
  "uses_arduino": true,
  "slots": [
    {
      "id": "breadboard",
      "role": {
        "mn": "Туршилтын самбар",
        "en": "Breadboard"
      },
      "part_type": "breadboard",
      "quantity": 1,
      "accept": {},
      "preferred": {}
    },
    {
      "id": "arduino",
      "role": {
        "mn": "Arduino (UNO эсвэл Nano)",
        "en": "Arduino (UNO or Nano)"
      },
      "part_type": "arduino",
      "quantity": 1,
      "accept": {},
      "preferred": {
        "part_number": "UNO"
      }
    },
    {
      "id": "r_led",
      "role": {
        "mn": "LED-ийн резистор (220Ω–1кΩ)",
        "en": "LED resistor (220Ω–1kΩ)"
      },
      "part_type": "resistor",
      "quantity": 1,
      "accept": {
        "preset": "led_resistor_5v"
      },
      "preferred": {
        "ohms": 220
      }
    },
    {
      "id": "led",
      "role": {
        "mn": "LED (дурын өнгө)",
        "en": "LED (any colour)"
      },
      "part_type": "led",
      "quantity": 1,
      "accept": {},
      "preferred": {
        "color": "red"
      }
    }
  ],
  "materials": [
    {
      "part_type": "jumper_wire",
      "quantity": 3
    }
  ],
  "layout": {
    "components": [
      {
        "ref": "ARD",
        "kind": "arduino",
        "pins": {},
        "slot": "arduino"
      },
      {
        "ref": "R1",
        "kind": "resistor",
        "pins": {
          "1": "c5",
          "2": "c8"
        },
        "slot": "r_led"
      },
      {
        "ref": "LED1",
        "kind": "led",
        "pins": {
          "A": "e8",
          "K": "e9"
        },
        "slot": "led"
      }
    ],
    "wires": [
      {
        "id": "WAG",
        "from": "ARD.GND",
        "to": "t-1",
        "color": "black"
      },
      {
        "id": "WD1",
        "from": "ARD.D13",
        "to": "a5",
        "color": "yellow"
      },
      {
        "id": "WG1",
        "from": "a9",
        "to": "t-9",
        "color": "black"
      }
    ]
  },
  "schematic": {
    "nets": [
      {
        "name": "D13",
        "pins": [
          "ARD.D13",
          "R1.1"
        ]
      },
      {
        "name": "LED1+",
        "pins": [
          "R1.2",
          "LED1.A"
        ]
      },
      {
        "name": "GND",
        "pins": [
          "ARD.GND",
          "LED1.K"
        ]
      }
    ]
  },
  "steps": [
    {
      "text": {
        "mn": "Arduino-гийн GND-ээс самбарын (−) шугам руу хар утас.",
        "en": "Black wire from Arduino GND to the breadboard (−) rail."
      },
      "add": [
        "ARD",
        "WAG"
      ]
    },
    {
      "text": {
        "mn": "D13-аас a5 руу утас. 220Ω резистор c5→c8.",
        "en": "Wire from D13 to a5. 220Ω resistor c5→c8."
      },
      "add": [
        "WD1",
        "R1"
      ]
    },
    {
      "text": {
        "mn": "LED урт хөл e8, богино хөл e9. a9→(−) хар утас.",
        "en": "LED long leg in e8, short leg in e9. Black wire a9→(−)."
      },
      "add": [
        "LED1",
        "WG1"
      ]
    },
    {
      "text": {
        "mn": "USB-ээр компьютерт холбож, доорх кодыг Arduino IDE-ээр ачаална.",
        "en": "Plug in USB and upload the code below with the Arduino IDE."
      },
      "add": []
    }
  ],
  "code": "const int LED_PIN = 13;\n\nvoid setup() {\n  pinMode(LED_PIN, OUTPUT);\n}\n\nvoid loop() {\n  digitalWrite(LED_PIN, HIGH);\n  delay(500);\n  digitalWrite(LED_PIN, LOW);\n  delay(500);\n}\n",
  "test": {
    "mn": "LED хагас секунд тутам анивчина. delay-ийн тоог өөрчилж хурдыг сольж үзээрэй.",
    "en": "The LED blinks every half second. Change the delay numbers to change the speed."
  },
  "safety": [
    {
      "mn": "Arduino-г зөвхөн USB (5В)-ээр тэжээнэ. Утас солихдоо USB-г салгана.",
      "en": "Power the Arduino from USB (5V) only. Unplug USB before you change wires."
    },
    {
      "mn": "LED-ийг резисторгүйгээр батарейд шууд холбож болохгүй — шатна.",
      "en": "Never connect an LED straight to the battery without its resistor — it burns out."
    }
  ],
  "optional_slots": []
}
