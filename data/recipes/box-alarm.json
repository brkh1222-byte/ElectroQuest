  ],
  "layout": {
    "components": [
      {
        "ref": "BAT",
        "kind": "battery",
        "pins": {},
        "slot": "battery"
      },
      {
        "ref": "Q1",
        "kind": "npn",
        "pins": {
          "C": "e15",
          "B": "e16",
          "E": "e17"
        },
        "slot": "npn"
      },
      {
        "ref": "LDR1",
        "kind": "ldr",
        "pins": {
          "1": "t+12",
          "2": "a12"
        },
        "slot": "ldr"
      },
      {
        "ref": "R1",
        "kind": "resistor",
        "pins": {
          "1": "b12",
          "2": "t-10"
        },
        "slot": "r_bottom"
      },
      {
        "ref": "R2",
        "kind": "resistor",
        "pins": {
          "1": "c12",
          "2": "a16"
        },
        "slot": "r_base"
      },
      {
        "ref": "BZ1",
        "kind": "buzzer",
        "pins": {
          "-": "c20",
          "+": "c23"
        },
        "slot": "buzzer"
      }
    ],
    "wires": [
      {
        "id": "WB+",
        "from": "BAT.+",
        "to": "t+1",
        "color": "red"
      },
      {
        "id": "WB-",
        "from": "BAT.-",
        "to": "t-1",
        "color": "black"
      },
      {
        "id": "W1",
        "from": "a17",
        "to": "t-17",
        "color": "black"
      },
      {
        "id": "W2",
        "from": "a15",
        "to": "a20",
        "color": "yellow"
      },
      {
        "id": "W3",
        "from": "a23",
        "to": "t+23",
        "color": "red"
      }
    ]
  },
  "schematic": {
    "nets": [
      {
        "name": "VCC",
        "pins": [
          "BAT.+",
          "LDR1.1",
          "BZ1.+"
        ]
      },
      {
        "name": "GND",
        "pins": [
          "BAT.-",
          "R1.2",
          "Q1.E"
        ]
      },
      {
        "name": "DIVIDER",
        "pins": [
          "LDR1.2",
          "R1.1",
          "R2.1"
        ]
      },
      {
        "name": "BASE",
        "pins": [
          "R2.2",
          "Q1.B"
        ]
      },
      {
        "name": "COLLECTOR",
        "pins": [
          "Q1.C",
          "BZ1.-"
        ]
      }
    ]
  },
  "steps": [
    {
      "text": {
        "mn": "Транзистор: e15 (C), e16 (B), e17 (E). a17→(−) хар утас.",
        "en": "Transistor: e15 (C), e16 (B), e17 (E). Black wire a17→(−)."
      },
      "add": [
        "Q1",
        "W1"
      ]
    },
    {
      "text": {
        "mn": "Гэрэл мэдрэгчийг (+) шугамаас a12 руу. 10кΩ резисторыг b12-оос (−) шугам руу.",
        "en": "Light sensor from the (+) rail to a12. 10kΩ resistor from b12 to the (−) rail."
      },
      "add": [
        "LDR1",
        "R1"
      ]
    },
    {
      "text": {
        "mn": "1кΩ резисторыг c12-оос a16 (база) руу.",
        "en": "1kΩ resistor from c12 to a16 (the base)."
      },
      "add": [
        "R2"
      ]
    },
    {
      "text": {
        "mn": "a15-аас a20 руу утас. Дуугаргагчийн (−) хөл c20, (+) хөл c23. a23→(+) улаан утас.",
        "en": "Wire from a15 to a20. Buzzer (−) leg in c20, (+) leg in c23. Red wire a23→(+)."
      },
      "add": [
        "W2",
        "BZ1",
        "W3"
      ]
    },
    {
      "text": {
        "mn": "Хамгийн сүүлд батарейгаа холбоно: улаан утсыг дээд (+) шугам, хар утсыг (−) шугамд.",
        "en": "Connect the battery last: red wire to the top (+) rail, black wire to the (−) rail."
      },
      "add": [
        "BAT",
        "WB+",
        "WB-"
      ]
    }
  ],
  "test": {
    "mn": "Мэдрэгчийг таглахад чимээгүй, гэрэл тусгахад дуугарна. Хайрцагт хийгээд нээж үзээрэй.",
    "en": "Silent when the sensor is covered, beeps in light. Put it in a box and open the lid."
  },
  "safety": [
    {
      "mn": "Зөвхөн батарейгаар ажиллуулна. Хэзээ ч цахилгааны залгуурт (220В) холбохгүй.",
      "en": "Battery power only. Never connect anything to a wall socket (220V)."
    }
  ],
  "optional_slots": []
}
