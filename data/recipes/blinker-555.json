  "steps": [
    {
      "text": {
        "mn": "555 чипийг голын ховилыг дайруулан тавина. Тойрог тэмдэг (1-р хөл) зүүн доод буланд: хөлүүд e10–e13 ба f10–f13.",
        "en": "Place the 555 chip across the middle gap with the dot (pin 1) at bottom-left: legs in e10–e13 and f10–f13."
      },
      "add": [
        "U1"
      ]
    },
    {
      "text": {
        "mn": "Дээд ба доод шугамыг холбоно: t+3→b+3 улаан, t−3→b−3 хар.",
        "en": "Join the top and bottom rails: t+3→b+3 red, t−3→b−3 black."
      },
      "add": [
        "WR+",
        "WR-"
      ]
    },
    {
      "text": {
        "mn": "Тэжээл: a10→(−) (1-р хөл GND), j10→доод (+) (8-р хөл), a13→дээд (+) (4-р хөл RESET).",
        "en": "Power: a10→(−) (pin 1 GND), j10→bottom (+) (pin 8), a13→top (+) (pin 4 RESET)."
      },
      "add": [
        "W1",
        "W2",
        "W3"
      ]
    },
    {
      "text": {
        "mn": "R1-ийг доод (+) шугамаас j11 руу, R2-ыг h11-ээс h12 руу. Эдгээр нь анивчих хурдыг тодорхойлно.",
        "en": "R1 from the bottom (+) rail to j11, R2 from h11 to h12. These set the blink speed."
      },
      "add": [
        "R1",
        "R2"
      ]
    },
    {
      "text": {
        "mn": "i12-оос b11 руу шар утас (6 ба 2-р хөлийг холбоно). Конденсаторын урт (+) хөлийг a11, судалтай (−) хөлийг (−) шугамд.",
        "en": "Yellow wire from i12 to b11 (joins pins 6 and 2). Capacitor: long (+) leg in a11, striped (−) leg in the (−) rail."
      },
      "add": [
        "W4",
        "C1"
      ]
    },
    {
      "text": {
        "mn": "Сонголттой: 10нФ конденсаторыг g13-аас доод (−) шугам руу (5-р хөл). Байхгүй бол алгасаарай.",
        "en": "Optional: 10nF capacitor from g13 to the bottom (−) rail (pin 5). Skip it if you don't have one."
      },
      "add": [
        "C2"
      ]
    },
    {
      "text": {
        "mn": "Гаралт (3-р хөл): резистор a12→a16, LED урт хөл e16, богино хөл e17, a17→(−) хар утас.",
        "en": "Output (pin 3): resistor a12→a16, LED long leg e16, short leg e17, black wire a17→(−)."
      },
      "add": [
        "R3",
        "LED1",
        "W5"
      ]
    },
    {
      "text": {
        "mn": "Хамгийн сүүлд батарейгаа холбоно: улаан утсыг дээд (+) шугам, хар утсыг (−) шугамд.",
        "en": "Connect the battery last: red wire to the top (+) rail, black wire to the (−) rail."
      },
      "add": [
        "BAT",
        "WB+",
        "WB-"
      ]
    }
  ],
  "test": {
    "mn": "LED секундэд ойролцоогоор нэг удаа анивчина. R2 эсвэл конденсаторыг томруулбал удааширна.",
    "en": "The LED blinks about once a second. A bigger R2 or capacitor makes it slower."
  },
  "safety": [
    {
      "mn": "Зөвхөн батарейгаар ажиллуулна. Хэзээ ч цахилгааны залгуурт (220В) холбохгүй.",
      "en": "Battery power only. Never connect anything to a wall socket (220V)."
    },
    {
      "mn": "LED-ийг резисторгүйгээр батарейд шууд холбож болохгүй — шатна.",
      "en": "Never connect an LED straight to the battery without its resistor — it burns out."
    },
    {
      "mn": "Электролит конденсаторын (−) судал талыг GND-д холбоно. Урвуу холбовол хавдаж, хагарч болно.",
      "en": "The electrolytic capacitor's striped (−) leg goes to GND. Reversed, it can swell and pop."
    }
  ]
}
