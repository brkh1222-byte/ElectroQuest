  "steps": [
    {
      "text": {
        "mn": "Arduino 5V → (+) шугам, GND → (−) шугам.",
        "en": "Arduino 5V → (+) rail, GND → (−) rail."
      },
      "add": [
        "ARD",
        "WA5",
        "WAG"
      ]
    },
    {
      "text": {
        "mn": "Потенциометр e10, e11, e12. a10→(+), a12→(−), a11 (дунд хөл)→A0.",
        "en": "Potentiometer in e10, e11, e12. a10→(+), a12→(−), a11 (middle)→A0."
      },
      "add": [
        "VR1",
        "W1",
        "W2",
        "W3"
      ]
    },
    {
      "text": {
        "mn": "Серво: улбар шар (дохио)→D9, улаан→(+) шугам, бор→(−) шугам.",
        "en": "Servo: orange (signal)→D9, red→(+) rail, brown→(−) rail."
      },
      "add": [
        "SV1",
        "W4",
        "W5",
        "W6"
      ]
    },
    {
      "text": {
        "mn": "Кодыг ачаална. Сервонд цаасан сум наавал заагч болно.",
        "en": "Upload the code. Tape a paper arrow to the servo horn to make a pointer."
      },
      "add": []
    }
  ],
  "code": "#include <Servo.h>\n\nServo pointer;\n\nvoid setup() {\n  pointer.attach(9);\n}\n\nvoid loop() {\n  int knob = analogRead(A0);            // 0..1023\n  pointer.write(map(knob, 0, 1023, 0, 180));\n  delay(15);\n}\n",
  "test": {
    "mn": "Потенциометрыг эргүүлэхэд серво 0–180° хооронд дагаж эргэнэ.",
    "en": "Turning the knob swings the servo between 0° and 180°."
  },
  "safety": [
    {
      "mn": "Arduino-г зөвхөн USB (5В)-ээр тэжээнэ. Утас солихдоо USB-г салгана.",
      "en": "Power the Arduino from USB (5V) only. Unplug USB before you change wires."
    },
    {
      "mn": "Arduino дахин ачаалагдаад байвал серво хэт их гүйдэл авч байна: сервог 4×AA батарейгаар тусад нь тэжээж, GND-ийг холбоно.",
      "en": "If the Arduino keeps resetting, the servo draws too much current: power it from a separate 4×AA pack and join the GNDs."
    }
  ],
  "optional_slots": []
}
