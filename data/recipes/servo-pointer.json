        "from": "a12",
        "to": "t-12",
        "color": "black"
      },
      {
        "id": "W3",
        "from": "a11",
        "to": "ARD.A0",
        "color": "green"
      },
      {
        "id": "W4",
        "from": "SV1.SIG",
        "to": "ARD.D9",
        "color": "orange"
      },
