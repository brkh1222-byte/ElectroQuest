  "schematic": {
    "nets": [
      {
        "name": "5V",
        "pins": [
          "ARD.5V",
          "VR1.1",
          "SV1.V+"
        ]
      },
      {
        "name": "GND",
        "pins": [
          "ARD.GND",
          "VR1.3",
          "SV1.GND"
        ]
      },
      {
        "name": "A0",
        "pins": [
          "VR1.W",
          "ARD.A0"
        ]
      },
      {
        "name": "D9",
        "pins": [
          "SV1.SIG",
          "ARD.D9"
        ]
      }
    ]
