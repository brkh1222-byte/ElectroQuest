  "steps": [
    {
      "text": {
        "mn": "Arduino 5V → (+) шугам, GND → (−) шугам.",
        "en": "Arduino 5V → (+) rail, GND → (−) rail."
      },
      "add": [
        "ARD",
        "WA5",
        "WAG"
      ]
    },
    {
      "text": {
        "mn": "Мэдрэгчийн хөлүүдийг e10 (VCC), e11 (Trig), e12 (Echo), e13 (GND)-д хийнэ. Нүднүүд нь гадагшаа харна.",
        "en": "Sensor pins in e10 (VCC), e11 (Trig), e12 (Echo), e13 (GND), eyes facing outward."
      },
      "add": [
        "US1"
      ]
    },
    {
      "text": {
        "mn": "a10→(+), a13→(−), a11→D9, a12→D10.",
        "en": "a10→(+), a13→(−), a11→D9, a12→D10."
      },
      "add": [
        "W1",
        "W4",
        "W2",
        "W3"
      ]
    },
    {
      "text": {
        "mn": "Анхааруулах LED: D7→a20, резистор c20→c23, LED e23 (урт) / e24, a24→(−).",
        "en": "Warning LED: D7→a20, resistor c20→c23, LED e23 (long) / e24, a24→(−)."
      },
      "add": [
        "WD1",
        "R1",
        "LED1",
        "WG1"
      ]
    },
    {
      "text": {
        "mn": "Кодыг ачаалаад Serial Monitor-ыг (9600) нээнэ.",
        "en": "Upload the code and open the Serial Monitor (9600 baud)."
      },
      "add": []
    }
  ],
  "code": "const int TRIG = 9, ECHO = 10, LED = 7;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(TRIG, OUTPUT);\n  pinMode(ECHO, INPUT);\n  pinMode(LED, OUTPUT);\n}\n\nvoid loop() {\n  digitalWrite(TRIG, LOW);\n  delayMicroseconds(2);\n  digitalWrite(TRIG, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(TRIG, LOW);\n\n  long us = pulseIn(ECHO, HIGH, 30000);  // 0 if nothing within ~5 m\n  if (us == 0) {\n    Serial.println(\"--\");\n    digitalWrite(LED, LOW);\n  } else {\n    float cm = us / 58.0;  // sound travels there and back\n    Serial.print(cm);\n    Serial.println(\" cm\");\n    digitalWrite(LED, cm < 20 ? HIGH : LOW);\n  }\n  delay(100);\n}\n",
  "test": {
    "mn": "Мэдрэгчийн өмнө гараа ойртуулахад Serial Monitor дээрх тоо багасаж, 20 см-ээс ойр болоход LED асна.",
    "en": "Move your hand toward the sensor: the number in the Serial Monitor drops and the LED lights under 20 cm."
  },
  "safety": [
    {
      "mn": "Arduino-г зөвхөн USB (5В)-ээр тэжээнэ. Утас солихдоо USB-г салгана.",
      "en": "Power the Arduino from USB (5V) only. Unplug USB before you change wires."
    },
    {
      "mn": "LED-ийг резисторгүйгээр батарейд шууд холбож болохгүй — шатна.",
      "en": "Never connect an LED straight to the battery without its resistor — it burns out."
    }
  ],
