        "from": "BAT.-",
        "to": "t-1",
        "color": "black"
      },
      {
        "id": "W1",
        "from": "t+8",
        "to": "a10",
        "color": "red"
      },
      {
        "id": "W2",
        "from": "a15",
        "to": "t-15",
        "color": "black"
      }
