  "steps": [
    {
      "text": {
        "mn": "Товчийг голын ховилыг дайруулан: e10, e12, f10, f12.",
        "en": "Button across the middle gap: e10, e12, f10, f12."
      },
      "add": [
        "S1"
      ]
    },
    {
      "text": {
        "mn": "(+) шугамаас a10 руу улаан утас.",
        "en": "Red wire from the (+) rail to a10."
      },
      "add": [
        "W1"
      ]
    },
    {
      "text": {
        "mn": "Дуугаргагч: урт (+) хөл c12, богино (−) хөл c15. a15→(−) хар утас.",
        "en": "Buzzer: long (+) leg in c12, short (−) leg in c15. Black wire a15→(−)."
      },
      "add": [
        "BZ1",
        "W2"
      ]
    },
    {
      "text": {
        "mn": "Хамгийн сүүлд батарейгаа холбоно: улаан утсыг дээд (+) шугам, хар утсыг (−) шугамд.",
        "en": "Connect the battery last: red wire to the top (+) rail, black wire to the (−) rail."
      },
      "add": [
        "BAT",
        "WB+",
        "WB-"
      ]
    }
  ],
  "test": {
    "mn": "Товч дарахад дуугарна.",
    "en": "It beeps while you press the button."
  },
  "safety": [
    {
      "mn": "Зөвхөн батарейгаар ажиллуулна. Хэзээ ч цахилгааны залгуурт (220В) холбохгүй.",
      "en": "Battery power only. Never connect anything to a wall socket (220V)."
    }
  ],
