  "steps": [
    {
      "text": {
        "mn": "Товчийг самбарын голын ховилыг дайруулан тавина: хөлүүд нь e10, e12, f10, f12.",
        "en": "Place the button across the middle gap: its legs go in e10, e12, f10 and f12."
      },
      "add": [
        "S1"
      ]
    },
    {
      "text": {
        "mn": "(+) шугамаас a10 руу улаан утас.",
        "en": "Red wire from the (+) rail to a10."
      },
      "add": [
        "W1"
      ]
    },
    {
      "text": {
        "mn": "Резисторыг a12-оос a16 хүртэл.",
        "en": "Resistor from a12 to a16."
      },
      "add": [
        "R1"
      ]
    },
    {
      "text": {
        "mn": "LED: урт хөл e16, богино хөл e17.",
        "en": "LED: long leg in e16, short leg in e17."
      },
      "add": [
        "LED1"
      ]
    },
    {
      "text": {
        "mn": "a17-оос (−) шугам руу хар утас.",
        "en": "Black wire from a17 to the (−) rail."
      },
      "add": [
        "W2"
      ]
    },
    {
      "text": {
        "mn": "Хамгийн сүүлд батарейгаа холбоно: улаан утсыг дээд (+) шугам, хар утсыг (−) шугамд.",
        "en": "Connect the battery last: red wire to the top (+) rail, black wire to the (−) rail."
      },
      "add": [
        "BAT",
        "WB+",
        "WB-"
      ]
    }
  ],
  "test": {
    "mn": "Товч дарахад LED асаж, тавихад унтарна.",
    "en": "The LED is on while you hold the button and off when you let go."
  },
  "safety": [
    {
      "mn": "Зөвхөн батарейгаар ажиллуулна. Хэзээ ч цахилгааны залгуурт (220В) холбохгүй.",
      "en": "Battery power only. Never connect anything to a wall socket (220V)."
    },
    {
      "mn": "LED-ийг резисторгүйгээр батарейд шууд холбож болохгүй — шатна.",
      "en": "Never connect an LED straight to the battery without its resistor — it burns out."
    }
  ],
  "optional_slots": []
}
