  "layout": {
    "components": [
      {
        "ref": "BAT",
        "kind": "battery",
        "pins": {},
        "slot": "battery"
      },
      {
        "ref": "Q1",
        "kind": "npn",
        "pins": {
          "C": "e15",
          "B": "e16",
          "E": "e17"
        },
        "slot": "npn"
      },
      {
        "ref": "R1",
        "kind": "resistor",
        "pins": {
          "1": "t+16",
          "2": "a16"
        },
        "slot": "r_top"
      },
      {
        "ref": "LDR1",
        "kind": "ldr",
        "pins": {
          "1": "b16",
          "2": "t-14"
        },
        "slot": "ldr"
      },
      {
        "ref": "R2",
        "kind": "resistor",
        "pins": {
          "1": "t+12",
          "2": "a14"
        },
        "slot": "r_led"
      },
      {
        "ref": "LED1",
        "kind": "led",
        "pins": {
          "A": "c14",
          "K": "c15"
        },
        "slot": "led"
      }
    ],
    "wires": [
      {
        "id": "WB+",
        "from": "BAT.+",
        "to": "t+1",
        "color": "red"
      },
      {
        "id": "WB-",
        "from": "BAT.-",
        "to": "t-1",
        "color": "black"
      },
      {
        "id": "W1",
        "from": "a17",
        "to": "t-17",
        "color": "black"
      }
    ]
  },
  "schematic": {
    "nets": [
      {
        "name": "VCC",
        "pins": [
          "BAT.+",
          "R1.1",
          "R2.1"
        ]
      },
      {
        "name": "GND",
        "pins": [
          "BAT.-",
          "LDR1.2",
          "Q1.E"
        ]
      },
      {
        "name": "BASE",
        "pins": [
          "Q1.B",
          "R1.2",
          "LDR1.1"
        ]
      },
      {
        "name": "LED+",
        "pins": [
          "R2.2",
          "LED1.A"
        ]
      },
      {
        "name": "COLLECTOR",
        "pins": [
          "LED1.K",
          "Q1.C"
        ]
      }
    ]
  },
  "steps": [
    {
      "text": {
        "mn": "Транзисторыг e15 (C), e16 (B), e17 (E)-д хийнэ. BC547 бол хавтгай талаа өөр лүүгээ харуулна. 2N2222 / 2N3904 / S8050 бол хавтгай талыг нь эсрэг харуулна.",
        "en": "Transistor in e15 (C), e16 (B), e17 (E). For a BC547 the flat side faces you. For a 2N2222 / 2N3904 / S8050 the flat side faces away."
      },
      "add": [
        "Q1"
      ]
    },
    {
      "text": {
        "mn": "a17-оос (−) шугам руу хар утас (эмиттер GND).",
        "en": "Black wire from a17 to the (−) rail (emitter to GND)."
      },
      "add": [
        "W1"
      ]
    },
    {
      "text": {
        "mn": "100кΩ резисторыг (+) шугамаас a16 руу. Гэрэл мэдрэгчийг b16-аас (−) шугам руу.",
        "en": "100kΩ resistor from the (+) rail to a16. Light sensor from b16 to the (−) rail."
      },
      "add": [
        "R1",
        "LDR1"
      ]
    },
    {
      "text": {
        "mn": "LED-ийн резисторыг (+) шугамаас a14 руу. LED: урт хөл c14, богино хөл c15.",
        "en": "LED resistor from the (+) rail to a14. LED: long leg in c14, short leg in c15."
      },
      "add": [
        "R2",
        "LED1"
      ]
    },
    {
      "text": {
        "mn": "Хамгийн сүүлд батарейгаа холбоно: улаан утсыг дээд (+) шугам, хар утсыг (−) шугамд.",
        "en": "Connect the battery last: red wire to the top (+) rail, black wire to the (−) rail."
      },
      "add": [
        "BAT",
        "WB+",
        "WB-"
      ]
    }
  ],
  "test": {
    "mn": "Гэрэл мэдрэгчийг гараараа таглах эсвэл өрөөний гэрлийг унтраахад LED асна.",
    "en": "Cover the light sensor with your hand or switch off the room light: the LED turns on."
  },
  "safety": [
    {
      "mn": "Зөвхөн батарейгаар ажиллуулна. Хэзээ ч цахилгааны залгуурт (220В) холбохгүй.",
      "en": "Battery power only. Never connect anything to a wall socket (220V)."
    },
    {
      "mn": "LED-ийг резисторгүйгээр батарейд шууд холбож болохгүй — шатна.",
      "en": "Never connect an LED straight to the battery without its resistor — it burns out."
    }
  ],
  "optional_slots": []
}
