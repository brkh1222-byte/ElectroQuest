  "steps": [
    {
      "text": {
        "mn": "Хоёр транзистор: Q1 e10 (C), e11 (B), e12 (E). Q2 e14 (C), e15 (B), e16 (E).",
        "en": "Two transistors: Q1 in e10 (C), e11 (B), e12 (E). Q2 in e14 (C), e15 (B), e16 (E)."
      },
      "add": [
        "Q1",
        "Q2"
      ]
    },
    {
      "text": {
        "mn": "a12→a15 утас (Q1-ийн эмиттер Q2-ын баз руу). a10→a14 утас (коллекторууд). a16→(−) хар утас.",
        "en": "Wire a12→a15 (Q1 emitter to Q2 base). Wire a10→a14 (collectors). Black wire a16→(−)."
      },
      "add": [
        "W2",
        "W3",
        "W4"
      ]
    },
    {
      "text": {
        "mn": "LED-ийн резистор (+) шугамаас a13 руу. LED урт хөл c13, богино хөл c14.",
        "en": "LED resistor from the (+) rail to a13. LED long leg in c13, short leg in c14."
      },
      "add": [
        "R2",
        "LED1"
      ]
    },
    {
      "text": {
        "mn": "Хүрэх цэг: хоёр утасны нэг үзүүрийг c5 ба c7-д хийж, нөгөө үзүүрийн тусгаарлагчийг хуулна. a5→(+) улаан утас, 1кΩ резистор a7→a11.",
        "en": "Touch pads: put one end of two wires in c5 and c7 and strip the other ends bare. Red wire a5→(+), 1kΩ resistor a7→a11."
      },
      "add": [
        "TP1",
        "W1",
        "R1"
      ]
    },
    {
      "text": {
        "mn": "Хамгийн сүүлд батарейгаа холбоно: улаан утсыг дээд (+) шугам, хар утсыг (−) шугамд.",
        "en": "Connect the battery last: red wire to the top (+) rail, black wire to the (−) rail."
      },
      "add": [
        "BAT",
        "WB+",
        "WB-"
      ]
    }
  ],
  "test": {
    "mn": "Хоёр нүцгэн утсанд нэг хуруугаараа зэрэг хүрэхэд LED асна.",
    "en": "Touch both bare wire ends with one finger: the LED lights up."
  },
  "safety": [
    {
      "mn": "Зөвхөн батарейгаар ажиллуулна. Хэзээ ч цахилгааны залгуурт (220В) холбохгүй.",
      "en": "Battery power only. Never connect anything to a wall socket (220V)."
    },
    {
      "mn": "LED-ийг резисторгүйгээр батарейд шууд холбож болохгүй — шатна.",
      "en": "Never connect an LED straight to the battery without its resistor — it burns out."
    },
    {
      "mn": "9В батарей хүнд аюулгүй. Энэ туршилтыг хэзээ ч залгуурын цахилгаантай хийхгүй.",
      "en": "A 9V battery is safe to touch. Never try this with wall power."
    }
  ],
