      },
      "add": [
        "BAT",
        "WB+",
        "WB-"
      ]
    }
  ],
  "test": {
    "mn": "Товч дарахад мотор эргэнэ. Утсыг сольж холбовол эсрэг зүг рүү эргэнэ.",
