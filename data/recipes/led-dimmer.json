{
  "id": "led-dimmer",
  "title": {
    "mn": "Гэрэл тохируулагч",
    "en": "LED dimmer"
  },
  "summary": {
    "mn": "Потенциометр эргүүлж LED-ийн гэрлийг тохируулна.",
    "en": "Turn a knob to make the LED brighter or dimmer."
  },
  "difficulty": 2,
  "time_minutes": 15,
  "what_you_learn": {
    "mn": "Эсэргүүцэл ихсэхэд гүйдэл багасдаг (Омын хууль).",
    "en": "More resistance means less current (Ohm's law)."
  },
  "supply_v": 9,
  "uses_arduino": false,
  "slots": [
    {
      "id": "breadboard",
      "role": {
        "mn": "Туршилтын самбар",
        "en": "Breadboard"
      },
      "part_type": "breadboard",
      "quantity": 1,
      "accept": {},
      "preferred": {}
    },
    {
      "id": "battery",
      "role": {
        "mn": "Батарей (4.5–9В)",
        "en": "Battery (4.5–9V)"
      },
      "part_type": "battery",
      "quantity": 1,
      "accept": {
        "preset": "battery_4v5_9v"
      },
      "preferred": {
        "volts": 9,
        "variant": "9v"
      }
    },
    {
      "id": "pot",
      "role": {
        "mn": "Потенциометр (1–100кΩ)",
        "en": "Potentiometer (1–100kΩ)"
      },
      "part_type": "potentiometer",
      "quantity": 1,
      "accept": {
        "preset": "pot_any"
      },
      "preferred": {
        "ohms": 10000
      }
    },
    {
      "id": "r_led",
      "role": {
        "mn": "LED-ийн резистор (390Ω–2.2кΩ)",
        "en": "LED resistor (390Ω–2.2kΩ)"
      },
      "part_type": "resistor",
      "quantity": 1,
      "accept": {
        "preset": "led_resistor_9v"
      },
      "preferred": {
        "ohms": 470
      }
    },
    {
      "id": "led",
      "role": {
        "mn": "LED (дурын өнгө)",
        "en": "LED (any colour)"
      },
      "part_type": "led",
      "quantity": 1,
      "accept": {},
      "preferred": {
        "color": "red"
      }
    }
  ],
  "materials": [
    {
      "part_type": "jumper_wire",
      "quantity": 4
    }
  ],
  "layout": {
    "components": [
      {
        "ref": "BAT",
        "kind": "battery",
        "pins": {},
        "slot": "battery"
      },
      {
        "ref": "VR1",
        "kind": "potentiometer",
        "pins": {
          "1": "e10",
          "3": "e12",
          "W": "e11"
        },
        "slot": "pot"
      },
      {
        "ref": "R1",
        "kind": "resistor",
        "pins": {
          "1": "c11",
          "2": "c15"
        },
        "slot": "r_led"
      },
      {
        "ref": "LED1",
        "kind": "led",
        "pins": {
          "A": "e15",
          "K": "e16"
        },
        "slot": "led"
      }
    ],
    "wires": [
      {
        "id": "WB+",
        "from": "BAT.+",
        "to": "t+1",
        "color": "red"
      },
      {
        "id": "WB-",
        "from": "BAT.-",
        "to": "t-1",
        "color": "black"
      },
      {
        "id": "W1",
        "from": "t+9",
        "to": "a10",
        "color": "red"
      },
      {
        "id": "W2",
        "from": "a11",
        "to": "a12",
        "color": "yellow"
      },
      {
        "id": "W3",
        "from": "a16",
        "to": "t-16",
        "color": "black"
      }
    ]
  },
  "schematic": {
    "nets": [
      {
        "name": "VCC",
        "pins": [
          "BAT.+",
          "VR1.1"
        ]
      },
      {
        "name": "WIPER",
        "pins": [
          "VR1.W",
          "VR1.3",
          "R1.1"
        ]
      },
      {
        "name": "LED+",
        "pins": [
          "R1.2",
          "LED1.A"
        ]
      },
      {
        "name": "GND",
        "pins": [
          "BAT.-",
          "LED1.K"
        ]
      }
    ]
  },
  "steps": [
    {
      "text": {
        "mn": "Потенциометрын 3 хөлийг e10, e11, e12-т хийнэ (дунд хөл нь e11).",
        "en": "Put the potentiometer's 3 legs in e10, e11, e12 (middle leg in e11)."
      },
      "add": [
        "VR1"
      ]
    },
    {
      "text": {
        "mn": "(+) шугамаас a10 руу улаан утас. a11-ээс a12 руу богино утас (дунд ба гурав дахь хөлийг холбоно).",
        "en": "Red wire from the (+) rail to a10. Short wire from a11 to a12 (joins the middle and third legs)."
      },
      "add": [
        "W1",
        "W2"
      ]
    },
    {
      "text": {
        "mn": "Резисторыг c11-ээс c15 хүртэл. Энэ резистор потенциометр 0 дээр байхад ч LED-ийг хамгаална.",
        "en": "Resistor from c11 to c15. It protects the LED even when the knob is turned all the way."
      },
      "add": [
        "R1"
      ]
    },
    {
      "text": {
        "mn": "LED: урт хөл e15, богино хөл e16. a16-аас (−) шугам руу хар утас.",
        "en": "LED: long leg in e15, short leg in e16. Black wire from a16 to the (−) rail."
      },
      "add": [
        "LED1",
        "W3"
      ]
    },
    {
      "text": {
        "mn": "Хамгийн сүүлд батарейгаа холбоно: улаан утсыг дээд (+) шугам, хар утсыг (−) шугамд.",
        "en": "Connect the battery last: red wire to the top (+) rail, black wire to the (−) rail."
      },
      "add": [
        "BAT",
        "WB+",
        "WB-"
      ]
    }
  ],
  "test": {
    "mn": "Бариулыг эргүүлэхэд LED гэрэлтэж, бүдгэрнэ.",
    "en": "Turning the knob makes the LED brighter and dimmer."
  },
  "safety": [
    {
      "mn": "Зөвхөн батарейгаар ажиллуулна. Хэзээ ч цахилгааны залгуурт (220В) холбохгүй.",
      "en": "Battery power only. Never connect anything to a wall socket (220V)."
    },
    {
      "mn": "LED-ийг резисторгүйгээр батарейд шууд холбож болохгүй — шатна.",
      "en": "Never connect an LED straight to the battery without its resistor — it burns out."
    }
  ],
  "optional_slots": []
}
