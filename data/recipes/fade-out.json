      {
        "name": "VCC",
        "pins": [
          "BAT.+",
          "S1.1"
        ]
      },
      {
        "name": "STORE",
        "pins": [
          "S1.2",
          "C1.+",
          "R1.1"
        ]
      },
      {
        "name": "LED+",
        "pins": [
          "R1.2",
          "LED1.A"
        ]
      },
