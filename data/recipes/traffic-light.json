    },
    {
      "text": {
        "mn": "Кодыг ачаална.",
        "en": "Upload the code."
      },
      "add": []
    }
  ],
  "code": "const int RED = 4, YELLOW = 3, GREEN = 2;\n\nvoid setup() {\n  pinMode(RED, OUTPUT);\n  pinMode(YELLOW, OUTPUT);\n  pinMode(GREEN, OUTPUT);\n}\n\nvoid show(int r, int y, int g, int ms) {\n  digitalWrite(RED, r);\n  digitalWrite(YELLOW, y);\n  digitalWrite(GREEN, g);\n  delay(ms);\n}\n\nvoid loop() {\n  show(HIGH, LOW, LOW, 4000);   // stop\n  show(HIGH, HIGH, LOW, 1000);  // get ready\n  show(LOW, LOW, HIGH, 4000);   // go\n  show(LOW, HIGH, LOW, 1000);   // slow down\n}\n",
  "test": {
    "mn": "Улаан → улаан+шар → ногоон → шар гэсэн дарааллаар давтагдана.",
    "en": "It cycles red → red+yellow → green → yellow."
  },
  "safety": [
    {
      "mn": "Arduino-г зөвхөн USB (5В)-ээр тэжээнэ. Утас солихдоо USB-г салгана.",
      "en": "Power the Arduino from USB (5V) only. Unplug USB before you change wires."
    },
    {
      "mn": "LED-ийг резисторгүйгээр батарейд шууд холбож болохгүй — шатна.",
      "en": "Never connect an LED straight to the battery without its resistor — it burns out."
    }
  ],
