  "steps": [
    {
      "text": {
        "mn": "Тоглогч A: товчийг e3, e5, f3, f5-д. (+) шугамаас a3 руу улаан утас.",
        "en": "Player A: button in e3, e5, f3, f5. Red wire from the (+) rail to a3."
      },
      "add": [
        "S1",
        "W1"
      ]
    },
    {
      "text": {
        "mn": "A-ийн гэрэл: резистор a5→a8, LED урт хөл e8, богино хөл e9, a9→(−) хар утас.",
        "en": "A's light: resistor a5→a8, LED long leg e8, short leg e9, black wire a9→(−)."
      },
      "add": [
        "R1",
        "LED1",
        "W2"
      ]
    },
    {
      "text": {
        "mn": "Тоглогч B: товчийг e16, e18, f16, f18-д. (+) шугамаас a16 руу улаан утас.",
        "en": "Player B: button in e16, e18, f16, f18. Red wire from the (+) rail to a16."
      },
      "add": [
        "S2",
        "W3"
      ]
    },
    {
      "text": {
        "mn": "B-ийн гэрэл: резистор a18→a21, LED урт хөл e21, богино хөл e22, a22→(−) хар утас.",
        "en": "B's light: resistor a18→a21, LED long leg e21, short leg e22, black wire a22→(−)."
      },
      "add": [
        "R2",
        "LED2",
        "W4"
      ]
    },
    {
      "text": {
        "mn": "Дуугаргагч: (+) хөл a12, (−) хөл a15, b15→(−) хар утас.",
        "en": "Buzzer: (+) leg in a12, (−) leg in a15, black wire b15→(−)."
      },
      "add": [
        "BZ1",
        "W5"
      ]
    },
    {
      "text": {
        "mn": "Диодууд: D1 c5→c12, D2 c18→d12. Судалтай (катод) тал нь дуугаргагч руу харна.",
        "en": "Diodes: D1 from c5 to c12, D2 from c18 to d12. The striped end (cathode) points to the buzzer."
      },
      "add": [
        "D1",
        "D2"
      ]
    },
    {
      "text": {
        "mn": "Хамгийн сүүлд батарейгаа холбоно: улаан утсыг дээд (+) шугам, хар утсыг (−) шугамд.",
        "en": "Connect the battery last: red wire to the top (+) rail, black wire to the (−) rail."
      },
      "add": [
        "BAT",
        "WB+",
        "WB-"
      ]
    }
  ],
  "test": {
    "mn": "A товч: A гэрэл + дуу. B товч: B гэрэл + дуу. Нэгийг дарахад нөгөө гэрэл асахгүй.",
    "en": "Button A: light A + beep. Button B: light B + beep. Pressing one never lights the other."
  },
  "safety": [
    {
      "mn": "Зөвхөн батарейгаар ажиллуулна. Хэзээ ч цахилгааны залгуурт (220В) холбохгүй.",
      "en": "Battery power only. Never connect anything to a wall socket (220V)."
    },
    {
      "mn": "LED-ийг резисторгүйгээр батарейд шууд холбож болохгүй — шатна.",
      "en": "Never connect an LED straight to the battery without its resistor — it burns out."
    }
  ],
