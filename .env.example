# Vercel AI Gateway. Locally: `vercel env pull` (OIDC) or set an API key.
AI_GATEWAY_API_KEY=

# Neon Postgres (Vercel Marketplace). Optional locally: submissions aren't persisted without it.
DATABASE_URL=

# Signs pipeline session tokens. Required in production: `openssl rand -base64 32`
SESSION_SECRET=

# Optional model overrides (verify slugs against the AI Gateway model list)
# EVALQUEST_DEFAULT_MODEL=google/gemini-2.5-flash-lite
# EVALQUEST_EMBEDDING_MODEL=openai/text-embedding-3-small
