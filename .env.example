# Get real values with `vercel link` + `vercel env pull` (all provisioned via Vercel Marketplace).

# Vercel AI Gateway. `vercel env pull` provides VERCEL_OIDC_TOKEN, or set an API key.
AI_GATEWAY_API_KEY=

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Upstash Redis: daily quota + pipeline attempt sessions
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Signs pipeline session tokens. Set in Vercel for preview/production; optional locally.
SESSION_SECRET=

# Optional model overrides (verify slugs against the AI Gateway model list)
# EVALQUEST_DEFAULT_MODEL=google/gemini-2.5-flash-lite
# EVALQUEST_EMBEDDING_MODEL=openai/text-embedding-3-small
