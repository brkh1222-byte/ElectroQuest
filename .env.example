# Server-side only. Never prefix these with NEXT_PUBLIC_ — the key must not reach the browser.

# Which model provider answers /api/ai: gemini (default, free tier) or claude.
AI_PROVIDER=gemini

# Gemini API key (https://aistudio.google.com/apikey). Free tier; Google may use free-tier requests to improve its models.
GEMINI_API_KEY=
# Fast tier: OCR, free-text answers, step chat. Strong tier: board defect analysis and golden-reference comparison.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash
# Thinking per tier (low | medium | high).
GEMINI_THINKING_FAST=low
GEMINI_THINKING_STRONG=low

# Claude API key (https://console.anthropic.com), used when AI_PROVIDER=claude. Without it, AI features show a retry/offline message
# and demo mode replays recorded answers.
ANTHROPIC_API_KEY=

# Fast/cheap model: OCR (chip markings, resistor bands, multimeter), free-text answers, step chat.
CLAUDE_MODEL_FAST=claude-haiku-5-5

# Stronger vision model: board defect analysis and golden-reference comparison.
CLAUDE_MODEL_STRONG=claude-opus-5-5

# Effort per tier (low | medium | high). "low" on the strong model halves board-analysis time
# (≈7s instead of ≈15s) with the same results in scripts/live-check.mjs.
CLAUDE_EFFORT_FAST=low
CLAUDE_EFFORT_STRONG=low

# Abuse protection for /api/ai (lib/rate-limit.ts). Extra hosts allowed to call it, comma-separated
# (localhost, electroquest.pages.dev and electroquest.*.workers.dev are always allowed).
ALLOWED_ORIGINS=
# Shared secret between the Pages proxy and the Worker so the visitor's real IP can be rate-limited.
# Set it with: npx wrangler secret put PROXY_KEY  and  npx wrangler pages secret put PROXY_KEY --project-name electroquest
PROXY_KEY=
